# for (z in zseq) {
#   print(z)
m <- m + 1
kl_med <- kl <- matrix(0, nrow = nsim, ncol = length(epsilon_list))
for (k in 1:nsim) {
if (k%%10 == 0) {print(k)}
mean_gen0 <- rnorm(n = 1, mean = 0, sd = 1)
var_gen0  <- 1 / rgamma(n = 1, shape = 4, rate = 1)^2
f0_med <- post_mu_med(mean_gen0, dnorm(0, sd = sqrt(var_gen0)), n)
f0 <- postmu(mean_gen0, var_gen0, n)
i <- 0
for (epsilon in epsilon_list) {
i <- i + 1
f_cont <- postmu(mean_gen(epsilon, z), var_gen(epsilon, z), n = n)
f_cont_med <- post_mu_med(med_gen(epsilon, z), f_med_gen(epsilon, z), n = n)
kl[k, i] <- kl_div(f0, f_cont, from = -20, to = 20, by = 0.01)
kl_med[k, i] <- kl_div_norm(mu1 = mean_post_med(0, z, n),
mu2 = mean_post_med(epsilon, z, n),
sd1 = sqrt(var_post_med(0, z, n)),
sd2 = sqrt(var_post_med(epsilon, z, n)))
}
}
Ediv[m, ] <- colMeans(kl)
Ediv_med[m, ] <- colMeans(kl_med)
plot(Ediv_med[m, ])
dEdiv_med <- dEdiv <- 0 * zseq
for (m in 1:length(zseq)) {
dEdiv[m] <- lm(I(sqrt(Ediv[m, ])) ~ epsilon_list)$coef[2]
dEdiv_med[m] <- lm(I(sqrt(Ediv_med[m, ])) ~ epsilon_list)$coef[2]
}
dEdiv_med[m, ]
dEdiv_med[m]
m
