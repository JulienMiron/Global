# Function to update beta_t
update <- function(beta, x, y) {
n <- length(y)
lambda <- 1 / (1 + exp(-x %*% beta))
# score
score <- c(0, 0)
for (i in 1:n) {
score <- score + (y[i] - lambda[i]) * x[i, ]
}
# J matrix
J <- matrix(0, nrow = 2, ncol = 2)
for (i in 1:n) {
J <- J + lambda[i] * (1 - lambda[i]) * x[i, ] %*% t(x[i, ])
}
return(beta + solve(J, score))
}
# Function to update beta_t
update <- function(beta, x, y) {
n <- length(y)
lambda <- 1 / (1 + exp(-x %*% beta))
# score
score <- c(0, 0)
for (i in 1:n) {
score <- score + (y[i] - lambda[i]) * x[i, ]
}
# J matrix
J <- matrix(0, nrow = 2, ncol = 2)
for (i in 1:n) {
J <- J + lambda[i] * (1 - lambda[i]) * x[i, ] %*% t(x[i, ])
}
return(beta + solve(J, score))
}
