temp <- read.table(file = 'temperature.txt', header = T)
head(temp)
par(mfrow=c(1, 1))
plot(temp[-1])
hist(temp$JanTemp) # slightly skewed, very unlikely non-negative values
temp$JanTemp
require(mgcv)
# default model "thin plate" regression splines
mod1 <- gam(JanTemp ~ s(Lat) + s(Long), data = temp)
par(mfrow = c(1, 2))
plot(mod1, residuals = TRUE, pch = 1)
par(mfrow = c(2, 2))
gam.check(mod1)
abline(0, 1)
summary(mod1)
summary(mod1)
mod2 <- gam(JanTemp ~ s(Lat, k = 20) + s(Long, k = 20), data = temp)
par(mfrow = c(1, 2))
plot(mod2, residuals = TRUE, pch = 1)
summary(mod2)
gam.check(mod2)
gam.check(mod2)
par(mfrow = c(2, 2))
gam.check(mod2)
gam.check(mod1)
gam.check(mod2)
mod2 <- gam(JanTemp ~ s(Lat, k = 3) + s(Long, k = 3), data = temp)
