data1 <- data.frame(y,x)
basis.dim <- 11
k <- basis.dim - 2
Knots <- seq(min(x), max(x), length.out = k)
form <- paste("b_cub(x, Knots[", 1:k, "])", sep = "", collapse = " + ")
form <- as.formula(paste("y ~ 1 + x +", form))
cub_spline_1 <- lm(form)
x1 <- seq(0, 4, 0.01)
sj <- seq(min(x1), max(x1), length.out = k)
X <- cub_X(x1, sj)
plot(x = x1, X[, 1], type = "l", ylim = c(0, 2))
for(i in 2:k){
lines(x = x1, X[, i])
}
X <- cub_X(x, Knots)
cub_spline_2 <- lm(y ~ X - 1)
#--g Overlay the cubic regression spline on your previous graph. Comment the fit of the different approaches.
plot(x, y, lwd = 2)
lines(x.grid, predict(poly5, newdata = neu, type = "response"),
type ="l", col = "magenta", lwd = 2)
lines(x.grid,predict(poly10,newdata = neu,type = "response"),
type = "l", col = "red", lwd = 2)
Xp <- cub_X(x.grid,Knots)
lines(x.grid, Xp%*%coef(cub_spline_2), col = "blue", lwd = 2)
lines(x.grid, predict(cub_spline_1,newdata = neu,
type = "response"), type = "l", col = "blue", lwd = 2)
legend(x = 2, y = 0.85,
legend = c("poly10", "poly5", paste("cub", basis.dim, sep = "")),
col = c("red", "magenta", "blue"), lwd = 2)
