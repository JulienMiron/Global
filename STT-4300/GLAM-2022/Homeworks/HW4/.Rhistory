MAME <- function(y, x, beta){
n <- length(y)
p <- ncol(x)
pred  <- x %*% beta
y_sort <- sort(y)
pred_sort <- sort(pred)
return(sum(abs(y_sort - pred_sort)))
}
grid_c <- seq(0.1, 10, 0.1)
n <- 125
p <- 2
x <- cbind(rep(1, n), matrix(runif((p - 1) * n), nrow = n))
y <- rnorm(n, mean = x %*% beta)
i <- 0
MAME_i <- vector()
for (c_rob in grid_c){
i <- i + 1
beta_i <- optim(c(0, 0), huber_reg, x = x, y = y, c_rob = c_rob)$par
MAME_i[i] <- MAME(y, x, beta_i)
}
plot(MAME_i)
