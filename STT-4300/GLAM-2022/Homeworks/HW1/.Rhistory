post = function(m, a_n, log = T) {
f = function(theta) {
if (log) {
return(dweibull((theta - m) / a_n, shape = 1, log = T) + prior(theta, log = T))
} else {
return(dweibull((theta - m) / a_n, shape = 1) * prior(theta, log = F))
}
}
return(f)
}
