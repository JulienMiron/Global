post = function(m, a_n, prior, log = T) {
f = function(theta) {
if (log) {
return(dexp((theta - m) / a_n, log = T) + prior(theta, log = T) - log(a_n))
} else {
return(dexp((theta - m) / a_n) * prior(theta, log = F) / a_n)
}
}
return(f)
}
