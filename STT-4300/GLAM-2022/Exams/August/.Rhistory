minuslogLikelihood <- function(theta,m0,N1,N2){
lambdaT = theta[2] + theta[3]
L = m0*log(theta[1] + (1-theta[1])*exp(-lambdaT)) + (n-m0)*(log(1-theta[1])-lambdaT) + N1*log(theta[2])+ N2*log(theta[3])
return(-1*L)
}
