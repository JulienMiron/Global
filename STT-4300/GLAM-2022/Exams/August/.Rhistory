#4.1 Simulation studies for m = 2
n = 50
L1 = 1
L2 = 3
Simul <- function(phi){
Z = rbinom(n,1,1-phi)
X1 = rpois(n,L1)
X2 = rpois(n,L2)
Y1 = Z*X1
Y2 = Z*X2
Ys = data.frame(Y1,Y2)
m0 = sum(Y1==0 & Y2==0)
N1 = sum(Y1)
N2 = sum(Y2)
List = list("Ys"=Ys, "Y1"=Y1, "Y2"=Y2 ,"m0"=m0, "N1"= N1, "N2"=N2 )
return(List)
}
Phi_low <- Simul(0.01)
Phi_high <- Simul(0.5)
#Likelihood ratio test: -2(likelihood_H0 - likelihood_H1) (3.12)
#formule likelihood (3.1)
logLikelihood <- function(phi,l1,l2,m0,N1,N2){
lambdaT = l1+l2
L = m0*log(phi + (1-phi)*exp(-lambdaT)) + (n-m0)*(log(1-phi)-lambdaT) + N1*log(l1)+ N2*log(l2)
return(L)
}
# theta = c(phi,l1,l2)
logLikelihood <- function(theta,m0,N1,N2){
lambdaT = theta[2] + theta[3]
L = m0*log(theta[1] + (1-theta[1])*exp(-lambdaT)) + (n-m0)*(log(1-theta[1])-lambdaT) + N1*log(theta[2])+ N2*log(theta[3])
return(L)
}
thetahat = optim(par=c(L1,L2),logLikelihood)
thetahat = optim(par=c(L1,L2),logLikelihood, m0=Phi_low$m0, N1=Phi_low$N1, N2=Phi_low$N2)
thetahat = optim(par=c(0.01,L1,L2),logLikelihood, m0=Phi_low$m0, N1=Phi_low$N1, N2=Phi_low$N2)
warnings()
