require(lme4)
require(gamlss.mx)
set.seed(156)
g <- 50  # Number of clusters
m <- 10 # Size of clusters
n <- m*g # Total number of observations
group <- as.factor(rep(1:g,each=m))
# parameters
beta1 <- c(1,2,1.5)
beta2 <- c(0.3)
# covariates
X <- cbind(1,rnorm(n),rnorm(n))
# random intercept and error term for the mean
gamma1 <- rnorm(g)
e <- rnorm(n)
psi1 <- 0.5
# constant variance
# for comparisons with lme4 (can add covariates later on, when only comparing our implementation with theirs))
sige <- exp(2*beta2)
# Generate y
y <- X%*%beta1 + psi1*rep(gamma1,each=m) + sige*e
dataf <- data.frame(y=y, x1=X[,2], x2=X[,3], group=group)
# Fit model
fit.lme <- lmer(y ~ x1+ x2 + (1| group), dataf)
summary(fit.lme)
fit.gamlssNP.gq <- gamlss.mx::gamlssNP(y~x1+x2,random= ~1 | group, K=10,mixture="gq", data=dataf)
summary(fit.gamlss.gq)
fit.gamlssGJRM <- GJRM::gamlss(y~x1+x2,random= ~1 | group, K=10,mixture="gq", data=dataf)
summary(fit.lme)
fit.gamlssNP.gq <- gamlss.mx::gamlssNP(y~x1+x2,random= ~1 | group, K=10,mixture="gq", data=dataf)
summary(fit.lme)
fit.gamlssNP.gq <- gamlss.mx::gamlssNP(y~x1+x2,random= ~1 | group, K=10,mixture="gq", data=dataf)
fit.lme <- lmer(y ~ x1+ x2 + (1| group), dataf)
summary(fit.lme)
fit.gamlssNP.gq <- gamlss.mx::gamlssNP(y~x1+x2,random= ~1 | group, K=10,mixture="gq", data=dataf)
summary(fit.gamlss.gq)
fit.lme <- lmer(y ~ x1+ x2 + (1| group), dataf)
summary(fit.lme)
fit.gamlssNP.gq <- gamlss.mx::gamlssNP(y~x1+x2,random= ~1 | group, K=10,mixture="gq", data=dataf)
summary(fit.gamlss.gq)
fit.lme <- lmer(y ~ x1+ x2 + (1| group), dataf)
summary(fit.lme)
fit.gamlssNP.gq <- gamlss.mx::gamlssNP(y~x1+x2,random= ~1 | group, K=10,mixture="gq", data=dataf)
summary(fit.gamlss.gq)
summary(fit.gamlssNP.gq)
